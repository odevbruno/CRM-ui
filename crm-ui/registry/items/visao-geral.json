{
  "name": "visao-geral",
  "type": "screen",
  "description": "Tela Visão geral (dashboard) completa e pronta.",
  "registryDependencies": [
    "button",
    "card",
    "statcard",
    "segmented",
    "badge",
    "themetoggle",
    "pageheader"
  ],
  "files": [
    {
      "path": "VisaoGeral.tsx",
      "target": "screens",
      "content": "'use client';\nimport { useState } from 'react';\nimport { Button } from '../components/Button';\nimport { Card, CardHeader, CardBody } from '../components/Card';\nimport { StatCard } from '../components/StatCard';\nimport { Segmented } from '../components/Segmented';\nimport { PageHeader } from '../components/PageHeader';\nimport { Tag } from '../components/Badge';\nimport { ThemeToggle } from '../components/ThemeToggle';\n\nconst PERIODS = ['Hoje', '7 dias', '30 dias'] as const;\n\n/**\n * Tela: Visão geral.\n * Composição: PageHeader → grid de 4 StatCard → grid 2 col (gráfico + autonomia)\n * → grid 2 col (feed de operação + [exceção + agenda de amanhã]).\n * Esta tela é o modelo de referência: qualquer tela nova segue esta mesma\n * ordem (header → stats → conteúdo em grid 2:1).\n */\nexport function VisaoGeral() {\n  const [period, setPeriod] = useState<(typeof PERIODS)[number]>('7 dias');\n\n  return (\n    <>\n      <PageHeader\n        title=\"Visão geral\"\n        description={\n          <span className=\"flex items-center gap-2\">\n            <span className=\"h-1.5 w-1.5 rounded-full bg-ok\" />\n            Operação em tempo real · atualizado há poucos segundos\n          </span>\n        }\n        actions={\n          <>\n            <Segmented options={PERIODS} value={period} onChange={setPeriod} />\n            <ThemeToggle />\n            <Button>\n              <PlusIcon /> Novo lead\n            </Button>\n            <Button variant=\"primary\">Testar agente</Button>\n          </>\n        }\n      />\n\n      <section className=\"mb-4 grid grid-cols-4 gap-4\">\n        <StatCard label=\"Leads hoje\" value={42} delta=\"+18%\" deltaTone=\"up\" hint=\"36 ontem no mesmo horário\"\n          sparkline=\"M0 22 L28 20 L56 21 L84 14 L112 15 L140 8 L168 9 L200 3\" />\n        <StatCard label=\"Conversas ativas\" value={17} delta=\"11 só IA\" hint=\"65% conduzidas sem humano\"\n          sparkline=\"M0 14 L28 18 L56 12 L84 14 L112 10 L140 12 L168 6 L200 8\" />\n        <StatCard label=\"Reuniões agendadas\" value={8} delta=\"+2\" deltaTone=\"up\" hint=\"5 sem intervenção humana\"\n          sparkline=\"M0 24 L28 24 L56 18 L84 18 L112 12 L140 12 L168 5 L200 4\" />\n        <StatCard label=\"Ligações da IA\" value={3} delta=\"2 viraram reunião\" hint=\"4 min em média por ligação\"\n          sparkline=\"M0 24 L40 24 L68 16 L110 16 L136 8 L172 8 L200 6\" />\n      </section>\n\n      <section className=\"mb-4 grid grid-cols-[2fr_1fr] gap-4\">\n        <Card>\n          <CardHeader title=\"Conversas e reuniões\" subtitle=\"últimas 24 horas\" />\n          <CardBody>{/* gráfico: ver reference/cotaflow-app.html#visao-geral para o SVG completo */}</CardBody>\n        </Card>\n        <Card>\n          <CardHeader title=\"Autonomia do agente\" />\n          <CardBody>\n            <div className=\"font-mono text-3xl font-medium tracking-tighter text-tx\">77%</div>\n            <p className=\"mt-1.5 mb-4 text-base text-tx2\">da operação anda sem intervenção humana</p>\n            <div className=\"flex h-2 gap-0.5 bg-grid\">\n              <span className=\"bg-accent\" style={{ width: '77%' }} />\n              <span className=\"bg-ghost\" style={{ width: '17%' }} />\n              <span className=\"bg-warn\" style={{ width: '6%' }} />\n            </div>\n          </CardBody>\n        </Card>\n      </section>\n\n      <section className=\"grid grid-cols-[2fr_1fr] gap-4\">\n        <Card>\n          <CardHeader title=\"Operação do agente\" subtitle=\"eventos que mudaram o estado de leads\" action={<Button>Ver todas</Button>} />\n          <OperationRow name=\"Ana Martins\" text=\"Objeção de preço identificada e tratada com a tabela de diferenciais\" tag={<Tag tone=\"ia\">IA</Tag>} time=\"há 2 min\" />\n          <OperationRow name=\"Carlos Silva\" text=\"Reunião criada para amanhã às 14:00 com Juliana, do comercial\" tag={<Tag tone=\"ok\">Reunião</Tag>} time=\"há 6 min\" />\n          <OperationRow name=\"Marcos Pereira\" text=\"Pediu 22% de desconto, acima do limite — negociação pausada\" tag={<Tag tone=\"warn\">Escalado</Tag>} time=\"há 11 min\" />\n        </Card>\n        <div className=\"flex flex-col gap-4\">\n          <Card>\n            <CardHeader title=\"Precisa de você\" subtitle=\"1 decisão\" />\n            <CardBody className=\"py-4\">\n              <p className=\"mb-3 font-mono text-lg leading-snug text-tx\">\n                \"Consigo fechar hoje se sair por 22% abaixo da tabela.\"\n              </p>\n              <div className=\"flex gap-2\">\n                <Button variant=\"primary\">Aprovar 22%</Button>\n                <Button>Contrapropor 15%</Button>\n                <Button variant=\"ghost\">Recusar</Button>\n              </div>\n            </CardBody>\n          </Card>\n        </div>\n      </section>\n    </>\n  );\n}\n\nfunction OperationRow({ name, text, tag, time }: { name: string; text: string; tag: React.ReactNode; time: string }) {\n  return (\n    <div className=\"grid grid-cols-[32px_1fr_auto] items-center gap-4 border-b border-line px-6 py-3.5 last:border-b-0\">\n      <div className=\"h-8 w-8 rounded-ds border border-line bg-surface2\" />\n      <div>\n        <b className=\"text-base font-medium text-tx\">{name}</b>\n        <p className=\"text-base text-tx2\">{text}</p>\n      </div>\n      <div className=\"text-right font-mono text-sm text-tx3\">\n        {tag}\n        <br />\n        {time}\n      </div>\n    </div>\n  );\n}\n\nfunction PlusIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth={2} strokeLinecap=\"round\" className=\"h-3.5 w-3.5\">\n      <path d=\"M12 5v14M5 12h14\" />\n    </svg>\n  );\n}\n"
    }
  ]
}